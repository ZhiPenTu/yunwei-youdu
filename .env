
# JAVA_HOME, will use it to start DolphinScheduler server
JAVA_HOME=${JAVA_HOME:-/opt/java/openjdk}

# Database related configuration, set database type, username and password
dolphinscheduler-resource-localDATABASE=${DATABASE:-postgresql}
dolphinscheduler-resource-localSPRING_PROFILES_ACTIVE=${DATABASE:-postgresql}
dolphinscheduler-resource-localSPRING_DATASOURCE_URL=${SPRING_DATASOURCE_URL:-jdbc:postgresql://localhost:5432/dolphinscheduler}
dolphinscheduler-resource-localSPRING_DATASOURCE_USERNAME=${SPRING_DATASOURCE_USERNAME:-root}
dolphinscheduler-resource-localSPRING_DATASOURCE_PASSWORD=${SPRING_DATASOURCE_PASSWORD:-root}

# DolphinScheduler server related configuration
dolphinscheduler-resource-localSPRING_CACHE_TYPE=${SPRING_CACHE_TYPE:-none}
dolphinscheduler-resource-localSPRING_JACKSON_TIME_ZONE=${SPRING_JACKSON_TIME_ZONE:-UTC}
dolphinscheduler-resource-localMASTER_FETCH_COMMAND_NUM=${MASTER_FETCH_COMMAND_NUM:-10}

# Registry center configuration, determines the type and link of the registry center
dolphinscheduler-resource-localREGISTRY_TYPE=${REGISTRY_TYPE:-zookeeper}
dolphinscheduler-resource-localREGISTRY_ZOOKEEPER_CONNECT_STRING=${REGISTRY_ZOOKEEPER_CONNECT_STRING:-localhost:2181}

# Tasks related configurations, need to change the configuration if you use the related tasks.
# dolphinscheduler-resource-localHADOOP_HOME=${HADOOP_HOME:-/opt/soft/hadoop}
# dolphinscheduler-resource-localHADOOP_CONF_DIR=${HADOOP_CONF_DIR:-/opt/soft/hadoop/etc/hadoop}
# dolphinscheduler-resource-localSPARK_HOME1=${SPARK_HOME1:-/opt/soft/spark1}
# dolphinscheduler-resource-localSPARK_HOME2=${SPARK_HOME2:-/opt/soft/spark2}
# dolphinscheduler-resource-localPYTHON_HOME=${PYTHON_HOME:-/opt/soft/python}
# dolphinscheduler-resource-localHIVE_HOME=${HIVE_HOME:-/opt/soft/hive}
# dolphinscheduler-resource-localFLINK_HOME=${FLINK_HOME:-/opt/soft/flink}
# dolphinscheduler-resource-localDATAX_HOME=${DATAX_HOME:-/opt/soft/datax}
dolphinscheduler-resource-localSEATUNNEL_HOME=${SEATUNNEL_HOME:-/opt/soft/seatunnel}
# dolphinscheduler-resource-localCHUNJUN_HOME=${CHUNJUN_HOME:-/opt/soft/chunjun}

dolphinscheduler-resource-localPATH=$HADOOP_HOME/bin:$SPARK_HOME1/bin:$SPARK_HOME2/bin:$PYTHON_HOME/bin:$JAVA_HOME/bin:$HIVE_HOME/bin:$FLINK_HOME/bin:$DATAX_HOME/bin:$SEATUNNEL_HOME/bin:$CHUNJUN_HOME/bin:$PATH