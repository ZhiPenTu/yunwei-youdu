# SeaTunnel数据同步任务环境变量配置示例
# 复制此文件为 .env 并填入实际配置值

# ================================
# MySQL数据库配置
# ================================
MYSQL_HOST=35.46.5.36
MYSQL_PORT=3306
MYSQL_DATABASE=vrc
MYSQL_USER=root
MYSQL_PASSWORD=HTcf2022!
MYSQL_TIMEOUT=1000

# ================================
# Doris数据库配置
# ================================
DORIS_FE_NODES=35.46.5.98:8030
DORIS_USERNAME=root
DORIS_PASSWORD=HTcf2022!
DORIS_DATABASE=db_htcf
DORIS_ENABLE_2PC=false
DORIS_LABEL_PREFIX=iot_json
DORIS_TIMEOUT=300

# ================================
# 任务执行配置
# ================================
TASK_BATCH_SIZE=1000
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=60
LOG_LEVEL=INFO
LOG_FILE=/tmp/seatunnel_task.log

# ================================
# DolphinScheduler工作流配置
# ================================
WORKFLOW_NAME=seatunnel_mysql_to_doris_sync
WORKFLOW_SCHEDULE=0 0 1 * * ? *
WORKFLOW_START_TIME=2024-01-01
WORKFLOW_TENANT=default
WORKFLOW_TIMEOUT=3600
WORKFLOW_WARNING_TYPE=failure
WORKFLOW_EXECUTION_TYPE=parallel

# ================================
# 安全注意事项
# ================================
# 1. 请勿将包含真实密码的 .env 文件提交到版本控制系统
# 2. 确保 .env 文件的权限设置为 600 (仅所有者可读写)
# 3. 在生产环境中使用强密码
# 4. 定期更换数据库密码
# 5. 考虑使用密钥管理服务存储敏感信息

# ================================
# 使用说明
# ================================
# 1. 复制此文件: cp .env.example .env
# 2. 编辑 .env 文件，填入实际配置值
# 3. 设置文件权限: chmod 600 .env
# 4. 在Python脚本中通过 os.getenv() 读取配置